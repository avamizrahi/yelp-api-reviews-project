        "#Define a function to insert data into the 'CA_population_data' table\n",
        "def insert_data(df):\n",
        "    conn, cur = get_conn_cur()\n",
        "\n",
        "    # SQL statement for inserting data\n",
        "    insert_query = \"\"\"\n",
        "    INSERT INTO CA_population_data (city, most_current_pop_year, population)\n",
        "    VALUES (%s, %s, %s)\n",
        "    \"\"\"\n",
        "\n",
        "    try:\n",
        "        #Iterate over each row in the DataFrame and insert the data into the table\n",
        "        # name=None generates tuples\n",
        "        for row in df.itertuples(index=False, name=None):\n",
        "            cur.execute(insert_query, row)\n",
        "\n",
        "        # Commit the transaction to save the changes\n",
        "        conn.commit()\n",
        "        print(\"Data inserted successfully.\")\n",
        "\n",
        "    # Print an error message if an exception occurs\n",
        "    except Exception as e:\n",

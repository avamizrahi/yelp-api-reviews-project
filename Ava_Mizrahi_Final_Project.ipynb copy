        "# Initialize an empty list to store individual shop reviews\n",
        "italian_shops_reviews_list = []\n",
        "\n",
        "# Iterate over each row in italian_shops_df\n",
        "for i in range(len(italian_shops_df)):\n",
        "    # Get the location ID, state, and city\n",
        "    location_id = italian_shops_df.loc[i, 'id']\n",
        "    state = italian_shops_df.loc[i, 'location.state']\n",
        "    city = italian_shops_df.loc[i, 'location.city']\n",
        "\n",
        "    # Query Yelp API for reviews\n",
        "    reviews = yelp_api.reviews_query(location_id)\n",
        "\n",
        "    # Normalize reviews and add 'state' and 'city' columns\n",
        "    reviews_df = pd.json_normalize(reviews, 'reviews')\n",
        "    reviews_df['state'] = state\n",
        "    reviews_df['city'] = city\n",
        "\n",
        "    # Append to the list\n",
        "    italian_shops_reviews_list.append(reviews_df)\n",
        "\n",
        "# Concatenate all reviews into a single DataFrame\n",
        "italian_shops_reviews_df = pd.concat(italian_shops_reviews_list)\n",
        "\n",
        "# Select specific columns from the DataFrame\n",
        "italian_shops_reviews_df = italian_shops_reviews_df[['id', 'text', 'rating', 'state', 'city']]\n"
      ],
